---
import Layout from '../../../layouts/Layout.astro';
import ConsultationSection from '../../../components/ConsultationSection.astro';
---

<Layout title="Services — Pearl Infotech" description="Discover our full suite of IT solutions including Web Development, Android, iOS, Quality Assurance, UI/UX Design, and Wearables." activeNav="services">
  <!-- Page Header / Sub-Banner -->
  <section class="services-header-hero page-sub-banner">
    <div class="sub-banner-glow"></div>
    <div class="sub-banner-pattern" aria-hidden="true"></div>
    <div class="container sub-banner-container">
      <div class="breadcrumb-pill">
        <a href="/it/" class="breadcrumb-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Home</span>
        </a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current">Services</span>
      </div>
      <div class="header-content">
        <span class="sub-banner-eyebrow">WHAT WE DO</span>
        <h1 class="page-title">Comprehensive IT Services</h1>
        <p class="page-desc">
          We combine technical engineering excellence with innovative design to deliver software, web, and mobile solutions tailored to your business needs.
        </p>
      </div>
    </div>
  </section>

  <!-- Service Catalogue Grid -->
  <section class="section">
    <div class="container">
      <div class="services-grid">
        <!-- 01 Web -->
        <article class="service-catalog-card">
          <div class="card-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h2 class="card-title">Web Development</h2>
          <p class="card-text">
            Our web development is efficient and take load to support millions of users. We provide service with server hosting to server management.
          </p>
          <a href="/it/web-development/" class="card-link">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </article>

        <!-- 02 Android -->
        <article class="service-catalog-card">
          <div class="card-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
          </div>
          <h2 class="card-title">Android Development</h2>
          <p class="card-text">
            We have specialized team with core knowledge for develop Android applications. Our product’s success tells our speciality in Android app development.
          </p>
          <a href="/it/android-development/" class="card-link">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </article>

        <!-- 03 iPhone -->
        <article class="service-catalog-card">
          <div class="card-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <circle cx="12" cy="18" r="1"></circle>
            </svg>
          </div>
          <h2 class="card-title">iPhone Development</h2>
          <p class="card-text">
            Pearl Infotech is involved in the develop mobile applications on the iOS platforms. Our developed application and product compatible with iPhones & iPads.
          </p>
          <a href="/it/ios-development/" class="card-link">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </article>

        <!-- 04 QA -->
        <article class="service-catalog-card">
          <div class="card-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h2 class="card-title">Quality Assurance</h2>
          <p class="card-text">
            Quality Assurance Service is important after make products for customer use. We provide Manual and Automated Quality Assurance service for Android and iPhone mobile products and Web Servers with details report.
          </p>
          <a href="/it/quality-assurance/" class="card-link">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </article>

        <!-- 05 UI/UX -->
        <article class="service-catalog-card">
          <div class="card-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h2 class="card-title">UI/UX Design</h2>
          <p class="card-text">
            The Design division at WorldWide Techno Solutions works as an independent wing with a dedicated team of User interface(UI) Designers, User Experience (UX) Designers, Graphic Designers and Animators.
          </p>
          <a href="/it/ui-ux-design/" class="card-link">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </article>

        <!-- 06 Wearables -->
        <article class="service-catalog-card">
          <div class="card-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="7"></circle>
              <polyline points="12 9 12 12 13.5 13.5"></polyline>
              <path d="M16.51 17.35l-.35 3.83a2 2 0 0 1-2 1.82H9.83a2 2 0 0 1-2-1.82l-.35-3.83m.01-10.7l.35-3.83A2 2 0 0 1 9.83 1h4.35a2 2 0 0 1 2 1.82l.35 3.83"></path>
            </svg>
          </div>
          <h2 class="card-title">Wearables App Development</h2>
          <p class="card-text">
            Our expertise in the wearable device apps development got accompanied with dedication, knowledge, and the zeal to explore the possible future made us deploy creative and innovative applications everytime.
          </p>
          <a href="/it/wearable-app-development/" class="card-link">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Consultation Section -->
  <ConsultationSection
    title="Ready to Build <span>Your Project?</span>"
    subtitle="Reach out to our specialist engineering team for a free technical consultation."
  />
</Layout>

<style>
  /* Sub-Banner / Page Hero */
  .page-sub-banner {
    position: relative;
    background: linear-gradient(135deg, rgba(0, 29, 76, 0.78) 0%, rgba(0, 75, 140, 0.68) 50%, rgba(0, 135, 202, 0.62) 100%),
                url('/assets/images/sub-banner-v1.jpg') center/cover no-repeat;
    color: #ffffff;
    padding: clamp(3.5rem, 5.5vw, 4.75rem) 0 clamp(3.5rem, 6vw, 5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    isolation: isolate;
  }

  .sub-banner-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 600px 320px at 85% 20%, rgba(0, 135, 202, 0.35), transparent 70%),
      radial-gradient(ellipse 450px 280px at 15% 85%, rgba(0, 135, 202, 0.2), transparent 70%);
    z-index: 0;
  }

  .sub-banner-pattern {
    position: absolute;
    right: -6vw;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(280px, 35vw, 460px);
    height: clamp(280px, 35vw, 460px);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 2.5rem rgba(255, 255, 255, 0.02),
      0 0 0 5rem rgba(255, 255, 255, 0.015),
      0 0 0 7.5rem rgba(255, 255, 255, 0.01);
    pointer-events: none;
    z-index: 0;
  }

  .sub-banner-container {
    position: relative;
    z-index: 1;
  }

  /* Breadcrumb Pill */
  .breadcrumb-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.8125rem;
    color: #CBD5E1;
    margin-bottom: 1.5rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary-subtle);
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: #fff;
  }

  .breadcrumb-pill .sep {
    color: rgba(255, 255, 255, 0.35);
  }

  .breadcrumb-pill .current {
    color: #ffffff;
    font-weight: 600;
  }

  .header-content {
    max-width: 780px;
  }

  .sub-banner-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .sub-banner-eyebrow::before {
    content: '';
    display: inline-block;
    width: 1.25rem;
    height: 2px;
    background-color: #fff;
    border-radius: var(--radius-sm);
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.125rem;
    color: #ffffff;
  }

  .page-desc {
    font-size: clamp(1.0625rem, 1.2vw, 1.1875rem);
    line-height: 1.7;
    color: #e2e8f0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 991px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  .service-catalog-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    padding: var(--card-padding);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-soft-sm);
    transition: all var(--transition-base);
  }

  .service-catalog-card:hover {
    border-color: rgba(36, 87, 245, 0.35);
    box-shadow: var(--shadow-soft-lg);
    transform: translateY(-4px);
  }

  .card-icon-box {
    width: 56px;
    height: 56px;
    border-radius: var(--card-radius);
    background: var(--color-primary-subtle);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
    border: 1px solid #0087ca33;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.4vw, 1.5rem);
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
    text-transform: capitalize;
  }

  .card-text {
    font-size: clamp(0.9375rem, 1vw, 1rem);
    color: var(--color-body);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }

  .card-link:hover {
    gap: 0.75rem;
    color: var(--color-primary-hover);
  }
</style>
