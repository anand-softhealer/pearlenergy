---
import ServicePageLayout from '../../../layouts/ServicePageLayout.astro';

const description = [
  "The right destination to get iOS App Development.",
  "Pearl Infotech is one of the best iPhone app development companies that promise to deliver industry-ready iOS apps. We have a team of expert iOS app developers making use of the latest technology to build functional, robust and appealing applications. We empower startups and businesses with customized iOS apps that can help them reach greater heights. From brainstorming to providing support for your iOS application, we keep in mind your audience which makes our app development company deliver the best solutions."
];

const capabilities = [
  "Run swiftly on iPhone SDK",
  "Cocoa touch/objective C/C++",
  "Efficient in using iPhone simulators",
  "Xcode IDE, interface builder",
  "Skillful development process ensuring best utilization of advanced   features of latest version of iPhone and iPad",
  "Open AL, open GL ES",
  "Core animation, core audio and graphics",
  "Accelerometer, GPS, Motion",
  "Efficient UI for your iPhone App"
];
---

<ServicePageLayout
  serviceKey="ios"
  title="iOS Development"
  headline="NATIVE APPLE ECOSYSTEM"
  tagline="Delivering high-performance, polished iPhone and iPad applications engineered for the Apple ecosystem."
  description={description}
  capabilitiesTitle="The Services of iPhone App Development"
  capabilities={capabilities}
  heroImage="/assets/images/ios.jpg"
/>
