---
import ServicePageLayout from '../../../layouts/ServicePageLayout.astro';

const description = [
  "The era is changing drastically. Every new day knocks the beginning of a new chapter in technology. Wearables are one such example to it. Our team has an impeccable command over the same. At Pearl Infotech, our primary focus is to design wearable applications which not only ease the standard of living, but we also make sure it works flawlessly."
];

const capabilities = [
  "iWatch App App",
  "Android wear App",
  "Google glass app"
];
---

<ServicePageLayout
  serviceKey="wearables"
  title="Wearables App Development"
  headline="NEXT-GEN SMART DEVICES"
  tagline="Delivering seamless, lightweight wearable applications for Apple Watch, Wear OS, and smart devices."
  description={description}
  capabilitiesTitle="Build Apps for the Best Wearable Devices"
  capabilities={capabilities}
  heroImage="/assets/images/wearables.jpg"
/>
