    <!-- Serialized Stations JSON for Zero-Latency Client Search & Autocomplete -->
    <!-- Serialized Stations JSON for Zero-Latency Client Search -->
    <script id="stationLocationsData" type="application/json" set:html={JSON.stringify(stationLocations)} />

    <!-- =================================================================
         CLIENT INTERACTIVITY LOGIC
         Sticky blur header, mobile drawer, Google Maps style suggestions & filter
         ================================================================= -->
    <!-- CLIENT INTERACTIVITY & SCROLL MOTION LOGIC -->
    <script>
      // 1. Sticky Header Shadow on Scroll
      const appHeader = document.getElementById('appHeader');
      window.addEventListener('scroll', () => {
        appHeader?.classList.toggle('is-scrolled', window.scrollY > 25);
      }, { passive: true });

      // 2. Mobile Drawer Navigation Toggle
      const mobileMenuBtn = document.getElementById('mobileMenuBtn');
      const drawerCloseBtn = document.getElementById('drawerCloseBtn');
      const drawerBackdrop = document.getElementById('drawerBackdrop');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const drawerNavItems = document.querySelectorAll('.drawer-nav-item');

      const openDrawer = () => {
        mobileDrawer?.classList.add('is-open');
        mobileMenuBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      };

      const closeDrawer = () => {
        mobileDrawer?.classList.remove('is-open');
        mobileMenuBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      };

      mobileMenuBtn?.addEventListener('click', openDrawer);
      drawerCloseBtn?.addEventListener('click', closeDrawer);
      drawerBackdrop?.addEventListener('click', closeDrawer);
      drawerNavItems.forEach((link) => link.addEventListener('click', closeDrawer));

      // 3. Hero Station Console Search & Redirection to Locations Page
      // 3. Hero Station Search Autocomplete
      const heroQuickSearch = document.getElementById('heroQuickSearch') as HTMLInputElement | null;
      const heroQuickGo = document.getElementById('heroQuickGo');

      // Live console quick preview elements
      const cqpName = document.getElementById('cqpName');
      const cqpAddr = document.getElementById('cqpAddr');
      const cqpFuels = document.getElementById('cqpFuels');
      const cqpStatus = document.getElementById('cqpStatus');
      const cqpLink = document.getElementById('cqpLink') as HTMLAnchorElement | null;

      // Redirection helper: routes query to Locations page
      function redirectToLocations(query?: string) {
        const q = (typeof query === 'string' ? query : (heroQuickSearch?.value || '')).trim();
        const targetUrl = q ? `/locations/?search=${encodeURIComponent(q)}` : '/locations/';
        window.location.href = targetUrl;
        window.location.href = q ? `/locations/?search=${encodeURIComponent(q)}` : '/locations/';
      }

      heroQuickGo?.addEventListener('click', (e) => {
        e.preventDefault();
        redirectToLocations();
      });
      heroQuickGo?.addEventListener('click', (e) => { e.preventDefault(); redirectToLocations(); });
      heroQuickSearch?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); redirectToLocations(); } });

      heroQuickSearch?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          redirectToLocations();
        }
      });

      // 4. Google Maps Style Search Autocomplete & Suggestions Engine
      const stationsDataScript = document.getElementById('stationLocationsData');
      const allStations: Array<{
        id: string;
        name: string;
        state: string;
        region: string;
        route: string;
        address: string;
        fuels: string[];
        amenities: string[];
        badge: string;
        status: string;
      }> = stationsDataScript && stationsDataScript.textContent ? JSON.parse(stationsDataScript.textContent) : [];
      const allStations: Array<{ id: string; name: string; state: string; address: string; fuels: string[]; status: string }> =
        stationsDataScript && stationsDataScript.textContent ? JSON.parse(stationsDataScript.textContent) : [];

      // Live preview update in hero as user types
      heroQuickSearch?.addEventListener('input', () => {
        const val = (heroQuickSearch.value || '').trim().toLowerCase();
        if (val) {
          const matched = allStations.find((s) =>
            s.name.toLowerCase().includes(val) ||
            s.address.toLowerCase().includes(val) ||
            s.region.toLowerCase().includes(val) ||
            s.state.toLowerCase() === val ||
            (s.fuels || []).some((f: string) => f.toLowerCase().includes(val)) ||
            (s.amenities || []).some((a: string) => a.toLowerCase().includes(val))
          );
          const matched = allStations.find((s) => s.name.toLowerCase().includes(val) || s.address.toLowerCase().includes(val) || s.state.toLowerCase() === val);
          if (matched) {
            if (cqpName) cqpName.textContent = matched.name;
            if (cqpAddr) cqpAddr.textContent = matched.address;
            if (cqpFuels) {
              const fuelsText = (matched.fuels || []).slice(0, 3).join(' • ');
              const amenityText = (matched.amenities || [])[0] ? ` • ${matched.amenities[0]}` : '';
              cqpFuels.textContent = `${fuelsText}${amenityText}`;
            }
            if (cqpFuels) cqpFuels.textContent = (matched.fuels || []).slice(0, 3).join(' • ');
            if (cqpStatus) cqpStatus.textContent = matched.status || 'Open 24/7';
            if (cqpLink) {
              cqpLink.href = `https://maps.google.com/?q=${encodeURIComponent('Pearl Energy ' + matched.name + ' ' + matched.address)}`;
            }
            if (cqpLink) cqpLink.href = `https://maps.google.com/?q=${encodeURIComponent('Pearl Energy ' + matched.name + ' ' + matched.address)}`;
          }
        }
      });

      function escapeRegExp(str: string) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      function highlightMatch(text: string, query: string) {
        if (!query.trim()) return text;
        const escaped = escapeRegExp(query.trim());
        const regex = new RegExp(`(${escaped})`, 'gi');
        return text.replace(regex, '<span class="gsd-highlight">$1</span>');
      }

      function setupGoogleMapsAutocomplete(config: {
        inputEl: HTMLInputElement | null;
        dropdownEl: HTMLElement | null;
        listEl: HTMLElement | null;
        countEl?: HTMLElement | null;
        kickerEl?: HTMLElement | null;
        onSelect: (st: any) => void;
      }) {
        const { inputEl, dropdownEl, listEl, countEl, kickerEl, onSelect } = config;
        if (!inputEl || !dropdownEl || !listEl) return;

        let selectedIndex = -1;
        let currentMatches: typeof allStations = [];

        function renderDropdown(matches: typeof allStations, query: string) {
          currentMatches = matches;
          selectedIndex = -1;

          if (matches.length === 0) {
            dropdownEl.classList.remove('is-open');
            inputEl.setAttribute('aria-expanded', 'false');
            return;
          }

          if (countEl) countEl.textContent = `${matches.length} verified`;
          if (kickerEl) {
            kickerEl.textContent = query.trim() ? `RESULTS FOR "${query.toUpperCase()}"` : 'POPULAR FORECOURTS & CORRIDORS';
          }

          listEl.innerHTML = matches
            .map((st, i) => {
              const fuelsList = (st.fuels || []).slice(0, 3).join(' &bull; ');
              const amenityBadge = (st.amenities || [])[0] ? `<span class="gsd-pill">${st.amenities[0]}</span>` : '';
              return `
                <div class="gsd-item" role="option" data-index="${i}" aria-selected="false">
                  <div class="gsd-pin-wrap">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </div>
                  <div class="gsd-meta">
                    <div class="gsd-title-row">
                      <span class="gsd-name">${highlightMatch(st.name, query)}</span>
                      <span class="gsd-state-tag">${st.state}</span>
                    </div>
                    <span class="gsd-address">${highlightMatch(st.address, query)}</span>
                    <div class="gsd-tags-row">
                      <span class="gsd-fuels">${fuelsList}</span>
                      ${amenityBadge}
                    </div>
                  </div>
                  <div class="gsd-action">
                    <span class="gsd-go-arrow">&rarr;</span>
                  </div>
                </div>
              `;
            })
            .join('');

          dropdownEl.classList.add('is-open');
          inputEl.setAttribute('aria-expanded', 'true');

          const items = listEl.querySelectorAll('.gsd-item');
          items.forEach((item) => {
            item.addEventListener('click', (e) => {
              e.preventDefault();
              const idx = parseInt(item.getAttribute('data-index') || '-1', 10);
              if (idx >= 0 && idx < currentMatches.length) {
                const picked = currentMatches[idx];
                inputEl.value = picked.name;
                dropdownEl.classList.remove('is-open');
                inputEl.setAttribute('aria-expanded', 'false');
                onSelect(picked);
              }
            });
          });
        }

        function filterStations(query: string): typeof allStations {
          const q = query.trim().toLowerCase();
          if (!q) {
            return allStations.slice(0, 5);
          }
          return allStations.filter((st) => {
            const haystack = `${st.name} ${st.address} ${st.region} ${st.route} ${st.state} ${(st.fuels || []).join(' ')} ${(st.amenities || []).join(' ')}`.toLowerCase();
            return haystack.includes(q);
          }).slice(0, 6);
        }

        inputEl.addEventListener('focus', () => {
          const query = inputEl.value || '';
          renderDropdown(filterStations(query), query);
        });

        inputEl.addEventListener('input', () => {
          const query = inputEl.value || '';
          renderDropdown(filterStations(query), query);
        });

        inputEl.addEventListener('keydown', (e) => {
          if (!dropdownEl.classList.contains('is-open')) {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
              const query = inputEl.value || '';
              renderDropdown(filterStations(query), query);
              e.preventDefault();
            }
            return;
          }

          const items = listEl.querySelectorAll('.gsd-item');
          if (items.length === 0) return;

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIndex = (selectedIndex + 1) % items.length;
            updateSelection(items);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIndex = (selectedIndex - 1 + items.length) % items.length;
            updateSelection(items);
          } else if (e.key === 'Enter') {
            if (selectedIndex >= 0 && selectedIndex < currentMatches.length) {
              e.preventDefault();
              const picked = currentMatches[selectedIndex];
              inputEl.value = picked.name;
              dropdownEl.classList.remove('is-open');
              inputEl.setAttribute('aria-expanded', 'false');
              onSelect(picked);
            }
          } else if (e.key === 'Escape') {
            dropdownEl.classList.remove('is-open');
            inputEl.setAttribute('aria-expanded', 'false');
          }
        });

        function updateSelection(items: NodeListOf<Element>) {
          items.forEach((it, i) => {
            if (i === selectedIndex) {
              it.classList.add('is-selected');
              it.setAttribute('aria-selected', 'true');
              (it as HTMLElement).scrollIntoView({ block: 'nearest' });
            } else {
              it.classList.remove('is-selected');
              it.setAttribute('aria-selected', 'false');
            }
          });
        }

        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (!inputEl.contains(target) && !dropdownEl.contains(target)) {
            dropdownEl.classList.remove('is-open');
            inputEl.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Initialize Hero Google Maps Autocomplete
      const heroSuggestionsDropdown = document.getElementById('heroSuggestionsDropdown');
      const heroGsdList = document.getElementById('heroGsdList');
      const heroGsdCount = document.getElementById('heroGsdCount');
      const heroGsdKicker = document.getElementById('heroGsdKicker');

      setupGoogleMapsAutocomplete({
        inputEl: heroQuickSearch,
        dropdownEl: heroSuggestionsDropdown,
        listEl: heroGsdList,
        countEl: heroGsdCount,
        kickerEl: heroGsdKicker,
        onSelect: (st) => {
          // 1. Update live console preview card
          if (cqpName) cqpName.textContent = st.name;
          if (cqpAddr) cqpAddr.textContent = st.address;
          if (cqpFuels) {
            const fuelsText = (st.fuels || []).slice(0, 3).join(' • ');
            const amenityText = (st.amenities || [])[0] ? ` • ${st.amenities[0]}` : '';
            cqpFuels.textContent = `${fuelsText}${amenityText}`;
          }
          if (cqpStatus) cqpStatus.textContent = st.status || 'Open 24/7';
          if (cqpLink) {
            cqpLink.href = `https://maps.google.com/?q=${encodeURIComponent('Pearl Energy ' + st.name + ' ' + st.address)}`;
          }

          // 2. Redirect to Locations page
          redirectToLocations(st.name);
        },
      });

      // View all link handler in dropdown footer
      document.getElementById('heroGsdViewAll')?.addEventListener('click', (e) => {
        e.preventDefault();
        redirectToLocations('');
      });

      // Console Amenity Filter Chips: automatically redirect to locations with filter query
      const consoleChips = document.querySelectorAll('.console-filter-chips .chip');
      consoleChips.forEach((chip) => {
        chip.addEventListener('click', (e) => {
          e.preventDefault();
          consoleChips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          const chipText = (chip.textContent || '').trim().toLowerCase();
          let targetQuery = '';
          if (chipText.includes('all')) {
            targetQuery = '';
          } else if (chipText.includes('diesel')) {
            targetQuery = 'diesel';
          } else if (chipText.includes('wash')) {
            targetQuery = 'wash';
          } else if (chipText.includes('café') || chipText.includes('cafe')) {
            targetQuery = 'café';
          } else if (chipText.includes('24/7')) {
            targetQuery = '24/7';
          }
          redirectToLocations(targetQuery);
        });
      });

      // 6. Interactive Video Modal Handler
      // 4. Video Player Modal Logic
      const pearlVideoTrigger = document.getElementById('pearlVideoTrigger');
      const videoModal = document.getElementById('videoModal');
      const videoModalClose = document.getElementById('videoModalClose');
      const videoIframe = document.getElementById('videoIframe') as HTMLIFrameElement | null;

      // Pearl Energy forecourt showcase video embed
      const videoEmbedUrl = 'https://www.youtube-nocookie.com/embed/ScMzIvxBSi4?autoplay=1&rel=0';

      const openVideoModal = () => {
        if (videoModal && videoIframe) {
          videoIframe.src = videoEmbedUrl;
          videoModal.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        }
        if (videoIframe) videoIframe.src = 'https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1';
        videoModal?.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      };

      const closeVideoModal = () => {
        if (videoModal && videoIframe) {
          videoModal.classList.remove('is-open');
          videoIframe.src = '';
          document.body.style.overflow = '';
        }
        if (videoIframe) videoIframe.src = '';
        videoModal?.classList.remove('is-open');
        document.body.style.overflow = '';
      };

      pearlVideoTrigger?.addEventListener('click', openVideoModal);
      pearlVideoTrigger?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openVideoModal();
        }
      });
      videoModalClose?.addEventListener('click', closeVideoModal);
      videoModal?.addEventListener('click', (e) => {
        if (e.target === videoModal) closeVideoModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && videoModal?.classList.contains('is-open')) {
          closeVideoModal();
        }
      });
      videoModal?.addEventListener('click', (e) => { if (e.target === videoModal) closeVideoModal(); });

      // 7. Executive Scroll Reveal & Motion Engine (Intersection Observer)
      // 5. Scroll Reveal Engine & Number Counter Animations
      const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Smooth Numeric Count-Up Animation
      function animateCounter(el: HTMLElement, target: number, duration: number = 1000) {
        if (isReducedMotion) {
          el.textContent = String(target);
          return;
        }
        if (isReducedMotion) { el.textContent = String(target); return; }
        let startTimestamp: number | null = null;
        const step = (timestamp: number) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const elapsed = timestamp - startTimestamp;
          const progress = Math.min(elapsed / duration, 1);
          // Ease-out cubic for luxury natural deceleration
