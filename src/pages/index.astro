            alt="Pearl Energy Forecourt Canopy in Daylight"
            class="hero-media-cover hero-media-zoom"
            width="2560"
            height="1529"
            fetchpriority="high"
          />
          <div class="hero-cinematic-scrim"></div>
        </div>

        <div class="hero-content-bounds">
          <div class="hero-layout-grid">
            <!-- Left Editorial Text Block -->
            <div class="hero-editorial-column">
              <div class="eyebrow-accent-badge">
                <span class="kicker-glow"></span>
                <span>AUSTRALIAN ENERGY NETWORK &bull; EXXONMOBIL ALLIANCE</span>
              </div>

              <h1 class="hero-display-headline hero-motion-item hero-motion-2">
                Fueling Every Journey. Powering Every Possibility.
                Fueling Every Journey.<br />
                <span class="hero-headline-gradient">Powering Every Possibility.</span>
              </h1>

              <p class="hero-editorial-lead hero-motion-item hero-motion-3">
                Discover a better service station experience with Pearl Energy. Quality fuel, everyday convenience and
                customer-focused services across Australia.
                Discover a higher standard of service station with Pearl Energy. Certified ExxonMobil Synergy™ fuels, Mobil 1 lubricants, and genuine Australian hospitality across 198+ stations nationwide.
              </p>

              <div class="hero-actions-row hero-motion-item hero-motion-4">
                <a href="#locations" class="btn btn-primary">
                  <span>Find a Station</span>
                </a>
                <a href="#services" class="btn btn-hero-ghost">
                  <span>Explore Our Services</span>
                  <span>Explore Forecourt Services</span>
                </a>
              </div>

              <!-- Executive Hero Trust Indicators -->
              <div class="hero-trust-indicators hero-motion-item hero-motion-5">
                <div class="hti-item">
                  <span class="hti-check">&#10003;</span>
                  <span>198+ Active Forecourts</span>
                </div>
                <div class="hti-dot">&bull;</div>
                <div class="hti-item">
                  <span class="hti-check">&#10003;</span>
                  <span>Official ExxonMobil Alliance</span>
                </div>
                <div class="hti-dot">&bull;</div>
                <div class="hti-item">
                  <span class="hti-check">&#10003;</span>
                  <span>100% Australian Quality Certified</span>
                </div>
              </div>
            </div>

            <!-- Right Interactive Station Console -->
            <!-- Right Interactive Station Command Console -->
            <div class="hero-console-column hero-motion-item hero-motion-5">
              <div class="live-console-card">
                <div class="console-head flex-between">
                  <div class="console-title-group">
                    <span class="console-radar-dot"></span>
                    <div>
                      <strong class="console-heading">Interactive Station Console</strong>
                      <span class="console-sub">198 Verified Stations Operating</span>
                    </div>
                  </div>
                  <span class="console-status-pill">Active Live</span>
                </div>

                <div class="console-search-box" id="heroSearchBoxWrap">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="cs-icon" aria-hidden="true">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="cs-icon">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                  </svg>
                  <input
                    type="text"
                    id="heroQuickSearch"
                    placeholder="Search suburb, highway or postcode..."
                    class="cs-input"
                    aria-label="Search Pearl Energy Stations"
                    autocomplete="off"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-expanded="false"
                    aria-controls="heroSuggestionsDropdown"
                  />
                  <button type="button" class="btn cs-btn" id="heroQuickGo">Search</button>

                  <!-- Google Maps Style Suggestions Popover -->
                  <div class="gmaps-suggestions-dropdown" id="heroSuggestionsDropdown" role="listbox" aria-label="Suggested Locations">
                  <div class="gmaps-suggestions-dropdown" id="heroSuggestionsDropdown" role="listbox">
                    <div class="gsd-header">
                      <span class="gsd-kicker" id="heroGsdKicker">POPULAR FORECOURTS &amp; CORRIDORS</span>
                      <span class="gsd-count" id="heroGsdCount">12 verified</span>
                    </div>
                    <div class="gsd-list" id="heroGsdList" tabindex="-1">
                      <!-- Rendered by client JavaScript -->
                    </div>
                    <div class="gsd-list" id="heroGsdList" tabindex="-1"></div>
                    <div class="gsd-footer">
                      <span class="gsd-footer-hint">Use <strong>&uarr;</strong> <strong>&darr;</strong> to browse &bull; <strong>Enter</strong> to select</span>
                      <a href="#locations" class="gsd-view-all-link" id="heroGsdViewAll">View all 198+ stations &rarr;</a>
                      <span class="gsd-footer-hint">Use <strong>&uarr;</strong> <strong>&darr;</strong> &bull; <strong>Enter</strong> to select</span>
                      <a href="#locations" class="gsd-view-all-link">View all 198+ stations &rarr;</a>
                    </div>
                  </div>
                </div>

                <div class="console-filter-chips">
                  <span class="cfc-label">Filter Amenities:</span>
                  <span class="cfc-label">Filter:</span>
                  <a href="#locations" class="chip active">All Forecourts</a>
                  <a href="#locations" class="chip">High-Flow Diesel</a>
                  <a href="#locations" class="chip">Touchless Wash</a>
                  <a href="#locations" class="chip">Artisan Café</a>
                  <a href="#locations" class="chip">24/7 Service</a>
                </div>

                <div class="console-quick-preview">
                  <div class="cqp-item">
                    <div class="cqp-info">
                      <strong class="cqp-name" id="cqpName">Bella Vista Flagship Terminal</strong>
                      <span class="cqp-addr" id="cqpAddr">1 Woolworths Way, Bella Vista NSW</span>
                      <span class="cqp-fuels" id="cqpFuels">Synergy 98 &bull; Premium 95 &bull; Ultra-Diesel &bull; Café</span>
                    </div>
                    <div class="cqp-cta">
                      <span class="cqp-badge" id="cqpStatus">Open 24/7</span>
                      <a href="https://maps.google.com/?q=Pearl+Energy+Bella+Vista+1+Woolworths+Way+Bella+Vista+NSW" target="_blank" rel="noopener noreferrer" class="qac-learn-link" id="cqpLink">Directions &rarr;</a>
                      <a href="https://maps.google.com/?q=Pearl+Energy+Bella+Vista" target="_blank" rel="noopener noreferrer" class="qac-learn-link" id="cqpLink">Directions &rarr;</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Ambient Bottom Transition -->
