---
import Layout from '../layouts/Layout.astro';
import ConsultationSection from '../components/ConsultationSection.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import ClientAvatar from '../components/ClientAvatar.astro';
import MissionVisionCard from '../components/MissionVisionCard.astro';
import { COMPANY_STATS } from '../data/stats';
import { TESTIMONIALS } from '../data/testimonials';
---

<Layout
  title="Pearl Infotech — IT Solutions"
  description="Pearl Infotech offers the latest IT solutions: Web Development, Android Development, iOS Development, Quality Assurance, UI/UX Design, and Wearables."
  activeNav="home"
>
  <!-- Section 01: Hero & Company Introduction (Artistic Agency Layout) -->
  <section class="hero-section">
    <div class="hero-pattern-bg"></div>
    <div class="hero-radial-glow"></div>
    <div class="container hero-container">
      <div class="hero-main-row">
        <!-- Content Column -->
        <div class="hero-content">
          <div class="eyebrow">
            <span>PEARL INFOTECH • AUSTRALIA</span>
          </div>
          <h1 class="hero-title">
            CREATING A BETTER <span class="highlight">IT SOLUTIONS</span>
          </h1>
          <p class="hero-description">
            Pearl Infotech is a growing team of creative, strategic, and professional engineers for software development in Australia. We specialize in Website development, Software development and Mobile applications for Android and iPhone Operating Systems.
          </p>

          <!-- Hero Action Buttons -->
          <div class="hero-actions-row">
            <a href="/it/contact-us/" class="btn btn-primary btn-sm">
              <span>Contact Us</span>
            </a>
            <a href="/it/about-us/" class="btn btn-secondary btn-sm">
              <span>About Us</span>
            </a>
          </div>
          
          <!-- Artistic Dual Proof & Action Block -->
          <div class="hero-dual-body">
            <!-- 5.0 Star Rating Box -->
            <div class="hero-rating-box">
              <div class="rating-header">
                <span class="rating-number">5.0</span>
                <span class="rating-count">({COMPANY_STATS.projectsDelivered} Projects)</span>
              </div>
              <div class="rating-stars" aria-label="5 stars rating">
                ★★★★★
              </div>
              <p class="rating-caption">Transforming digital processes for our clients</p>
            </div>

            <!-- Get Started Circular Interactive CTA -->
            <div class="hero-cta-circle-wrap">
              <p class="cta-micro-text">Transform every digital process with us.</p>
              <a href="/it/contact-us/#consultation-form" class="hero-rotating-cta" aria-label="Start consultation with Pearl Infotech">
                <svg class="cta-svg-text" viewBox="0 0 100 100" width="94" height="94">
                  <path id="circlePath" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none"></path>
                  <text font-size="9.5" font-weight="700" letter-spacing="2.2px" fill="currentColor">
                    <textPath href="#circlePath" startOffset="0%">• START NOW • IT SOLUTIONS •</textPath>
                  </text>
                </svg>
                <span class="cta-center-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </div>
        </div>

        <!-- Visual Multi-Image Collage Column (Artistic Layout) -->
        <div class="hero-image-column">
          <div class="hero-collage">
            <!-- Tall Left Image Card -->
            <div class="collage-card collage-card-tall">
              <img 
                src="/assets/images/about-thumb-1.jpg" 
                alt="Pearl Infotech Engineering Team Collaboration" 
                class="collage-img"
                width="400"
                height="520"
                loading="eager"
              />
            </div>

            <!-- Stacked Right Column Image Cards -->
            <div class="collage-right-stack">
              <div class="collage-card collage-card-top">
                <img 
                  src="/assets/images/hero-banner-tech.jpg" 
                  alt="Pearl Infotech Software Engineering" 
                  class="collage-img"
                  width="400"
                  height="250"
                  loading="eager"
                />
              </div>

              <div class="collage-card collage-card-bottom">
                <img 
                  src="/assets/images/about-thumb-2.jpg" 
                  alt="Pearl Infotech Quality Assurance & UI/UX" 
                  class="collage-img"
                  width="400"
                  height="250"
                  loading="eager"
                />
              </div>
            </div>

            <!-- Satisfied Client Pill Badge (Bottom Center) -->
            <div class="hero-satisfied-badge">
              <div class="badge-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div class="badge-content">
                <strong>{COMPANY_STATS.projectsDelivered}</strong>
                <span>Projects Completed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Artistic Scrolling Marquee Ticker -->
  <div class="artistic-ticker-wrap" aria-hidden="true">
    <div class="artistic-ticker">
      <div class="ticker-track">
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Web Development</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Mobile Applications</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Quality Assurance</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> UI/UX Design</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Wearable Apps</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Enterprise Software</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Cloud Solutions</span>
      </div>
      <div class="ticker-track" aria-hidden="true">
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Web Development</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Mobile Applications</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Quality Assurance</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> UI/UX Design</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Wearable Apps</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Enterprise Software</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Cloud Solutions</span>
      </div>
    </div>
  </div>

  <!-- Section 02: What We Do (Artistic 4-Column Feature Panel Layout) -->
  <section class="section section-features" id="features">
    <div class="container">
      <div class="artistic-feature-panel">
        <div class="feature-layout-grid">
          <!-- Column 1: Left Brand & Call to Action -->
          <div class="feature-brand-col">
            <div class="eyebrow">
              <span>PEARL INFOTECH</span>
            </div>
            <h2 class="feature-main-title">
              Latest IT Solutions <span class="highlight">for Your Business!</span>
            </h2>
            <div class="feature-cta-wrap">
              <a href="/it/contact-us/#consultation-form" class="btn btn-primary btn-sm">
                <span>Contact Us</span>
              </a>
            </div>
          </div>

          <!-- Column 2: IT Expertise -->
          <div class="feature-card-col">
            <div class="feature-card-circle-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="18" rx="3"></rect>
                <line x1="2" y1="9" x2="22" y2="9"></line>
                <circle cx="12" cy="15" r="3.2"></circle>
              </svg>
            </div>
            <h3 class="feature-card-title">IT Expertise</h3>
            <p class="feature-card-desc">
              We specialists in Website development, Software development and Mobile applications for Android and iPhone Operating System.
            </p>
          </div>

          <!-- Column 3: 24/7 IT Support -->
          <div class="feature-card-col">
            <div class="feature-card-circle-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class="feature-card-title">24/7 IT Support</h3>
            <p class="feature-card-desc">
              Dedicated 24/7 IT Support for managed clients, technical infrastructure, and system stability.
            </p>
          </div>

          <!-- Column 4: Custom Request -->
          <div class="feature-card-col">
            <div class="feature-card-circle-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h3 class="feature-card-title">Custom Request</h3>
            <p class="feature-card-desc">
              Tailored software development, custom integrations, and consultation services built to your exact needs.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section section-alt">
    <div class="container">
      <div class="mission-vision-grid">
        <MissionVisionCard
          type="mission"
          statement="Our mission is to better software development by being Innovative, Agile and bringing together capable, driven and passionate people."
        />

        <MissionVisionCard
          type="vision"
          statement="We believe to build long term relationship with client and agencies."
        />
      </div>
    </div>
  </section>

  <!-- Section 03: Services (Artistic 2-Column Section Header & Card Structure) -->
  <section class="section" id="services">
    <div class="container">
      <div class="artistic-section-header">
        <div class="section-header-left">
          <span class="eyebrow">SERVICES</span>
          <h2 class="section-title">Our Digital IT <span>Services</span></h2>
        </div>
        <div class="section-header-right">
          <p class="section-header-desc">
            High-performance, secure software engineering and design built to elevate your business operations and digital market reach.
          </p>
          <a href="/it/services/" class="btn btn-outline btn-sm">
            <span>See All Services</span>
          </a>
        </div>
      </div>

      <div class="services-grid">
        <!-- 01 Web Development -->
        <div class="service-card-item">
          <span class="service-card-number">01</span>
          <div class="service-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3 class="service-card-title">Web Development</h3>
          <p class="service-card-desc">
            At Pearl Infotech, we believe in delivering a web development solution that brings results for your business.
          </p>
          <a href="/it/web-development/" class="service-read-more">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- 02 Android Development -->
        <div class="service-card-item">
          <span class="service-card-number">02</span>
          <div class="service-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
          </div>
          <h3 class="service-card-title">Android Development</h3>
          <p class="service-card-desc">
            We provide exceptional custom Android application development services to clients all over the world.
          </p>
          <a href="/it/android-development/" class="service-read-more">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- 03 iPhone Development -->
        <div class="service-card-item">
          <span class="service-card-number">03</span>
          <div class="service-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <circle cx="12" cy="18" r="1"></circle>
            </svg>
          </div>
          <h3 class="service-card-title">iPhone Development</h3>
          <p class="service-card-desc">
            We are one of the leading iOS app development companies, and we provide efficient iPhone app development solutions.
          </p>
          <a href="/it/ios-development/" class="service-read-more">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- 04 Quality Assurance -->
        <div class="service-card-item">
          <span class="service-card-number">04</span>
          <div class="service-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="service-card-title">Quality Assurance</h3>
          <p class="service-card-desc">
            Efficient and successful solutions are those that are free from any errors or defects. If you need a quality assurance service for your existing solutions, you can rely on our experience, expertise, and quality assurance testing methods.
          </p>
          <a href="/it/quality-assurance/" class="service-read-more">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- 05 UI/UX Design -->
        <div class="service-card-item">
          <span class="service-card-number">05</span>
          <div class="service-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h3 class="service-card-title">UI/UX Design</h3>
          <p class="service-card-desc">
            Having a beautiful website today is no longer an option, but a necessity as it helps businesses connect to their prospective customers. We are the best web design company which help clients to deal with their unique website requirements.
          </p>
          <a href="/it/ui-ux-design/" class="service-read-more">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- 06 Wearables App Development -->
        <div class="service-card-item">
          <span class="service-card-number">06</span>
          <div class="service-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="7"></circle>
              <polyline points="12 9 12 12 13.5 13.5"></polyline>
              <path d="M16.51 17.35l-.35 3.83a2 2 0 0 1-2 1.82H9.83a2 2 0 0 1-2-1.82l-.35-3.83m.01-10.7l.35-3.83A2 2 0 0 1 9.83 1h4.35a2 2 0 0 1 2 1.82l.35 3.83"></path>
            </svg>
          </div>
          <h3 class="service-card-title">Wearables App Development</h3>
          <p class="service-card-desc">
            We are one of the leading wearable device application development companies, and we provide remarkable Apple Watch App development and Android Wear App development solutions.
          </p>
          <a href="/it/wearable-app-development/" class="service-read-more">
            <span>Read More</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 04 & 05: Works About / Company Overview & Completed Projects (Artistic Social-Media-Marketing About Box Layout) -->
  <section class="section section-alt works-about-section">
    <div class="container">
      <div class="artistic-about-box">
        <!-- Visual Image & Project Counter (Left Column in Artistic) -->
        <div class="artistic-about-image-col">
          <div class="artistic-about-img-frame">
            <img
              src="/assets/images/works-about.jpg"
              alt="Pearl Infotech Development Team"
              class="works-img"
              width="600"
              height="400"
              loading="lazy"
            />
            <!-- Artistic Floating Experience Pill Badge -->
            <div class="artistic-experience-badge">
              <div class="exp-counter-box">
                <span class="exp-number" id="projectsCounter" data-target={COMPANY_STATS.projectsDeliveredCount}>{COMPANY_STATS.projectsDelivered}</span>
              </div>
              <div class="exp-content">
                <span class="exp-title">Completed Projects</span>
                <span class="exp-sub">Enterprise Engineering</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Content Side (Right Column in Artistic) -->
        <div class="artistic-about-content-col">
          <div class="section-title-wrap">
            <span class="eyebrow">ABOUT US</span>
            <h2 class="artistic-heading">
              Developing <span>Amazing Things</span> with Passion
            </h2>
          </div>
          <p class="works-about-paragraph">
            Pearl Infotech believe to build long term relationship with client and agencies. Our specialists are fit for working in a large portion of the technologies and platforms. We offer top-notch subjective assistance by creating robust, secured, and high-performing website development that gives the best client experience. Having years of involvement in the custom Website & Mobile Application development field, we have expertise in building complex arrangements according to the changing requirements of the business.
          </p>

          <!-- Artistic Mini Feature Badges List -->
          <div class="artistic-about-list">
            <div class="artistic-list-item">
              <div class="artistic-list-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="artistic-list-text">
                <h4>{COMPANY_STATS.clientSatisfaction} Client Satisfaction</h4>
              </div>
            </div>

            <div class="artistic-list-item">
              <div class="artistic-list-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <div class="artistic-list-text">
                <h4>Professional Project Flows</h4>
              </div>
            </div>
          </div>

          <div class="artistic-about-footer">
            <a href="/it/contact-us/" class="btn btn-primary btn-sm">
              <span>Contact Us</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 06: Testimonials (Artistic 2-Column Section Header & Owl Carousel) -->
  <section class="section">
    <div class="container">
      <div class="artistic-section-header">
        <div class="section-header-left">
          <span class="eyebrow">TESTIMONIALS</span>
          <h2 class="section-title">What <span>People Say</span></h2>
        </div>
        <div class="section-header-right">
          <p class="section-header-desc">
            Honest feedback from technology leaders and clients who trust Pearl Infotech to engineer their digital products.
          </p>
          <a href="/it/contact-us/" class="btn btn-outline btn-sm">
            <span>Contact Us</span>
          </a>
        </div>
      </div>

      <!-- Owl Carousel Container (exact user structure) -->
      <div class="owl-carousel owl-theme testimonials-carousel">
