<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pearl Energy Australia — A Higher Standard for Every Journey</title>
    <meta
      name="description"
      content="Pearl Energy is an established Australian independent energy brand operating 198+ modern service stations across NSW, QLD, VIC & ACT in alliance with ExxonMobil."
      content="Pearl Energy is an established Australian independent energy network operating 198+ modern service stations across NSW, QLD, VIC & ACT in alliance with ExxonMobil."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,700&display=swap"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Immediate progressive enhancement flag for smooth, accessible scroll motion -->
    <script is:inline>
      document.documentElement.classList.add('js-motion');
    </script>
  </head>

  <body>
    <!-- =================================================================
         SECTION 01: ARCHITECTURAL FLOATING NAVIGATION HEADER
         ================================================================= -->
    <!-- 01: ARCHITECTURAL FLOATING NAVIGATION HEADER -->
    <header class="app-header" id="appHeader">
      <div class="header-utility-strip" role="region" aria-label="Pearl Energy Network Highlights">
      <div class="header-utility-strip" role="region" aria-label="Pearl Energy Highlights">
        <div class="header-container flex-between">
          <!-- Left: Network Live Status & Strategic Alliance Badge -->
          <div class="utility-left">
            <div class="utility-stat-chip">
              <span class="live-status-dot" aria-hidden="true"></span>
              <span class="utility-txt">
                <strong>198+ Active Forecourts</strong>
                <span class="utility-region-label">&bull; NSW, QLD, VIC &amp; ACT</span>
              </span>
            </div>
            <span class="utility-divider" aria-hidden="true"></span>
            <div class="utility-alliance-badge">
              <svg class="alliance-shield-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
              <span>Official ExxonMobil Alliance</span>
            </div>
          </div>

          <!-- Right: Direct Contact & Commercial Fleet Gateway -->
          <div class="utility-right">
            <a href="mailto:info@pearlenergy.com.au" class="utility-link utility-email" aria-label="Email Pearl Energy Support">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <a href="mailto:info@pearlenergy.com.au" class="utility-link utility-email">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
              </svg>
              <span>info@pearlenergy.com.au</span>
            </a>
            <span class="utility-divider" aria-hidden="true"></span>
            <a href="#fleet" class="utility-link utility-fleet-cta">
              <span>Commercial Fleet Accounts</span>
              <svg class="utility-arrow-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="header-main-nav">
        <div class="header-container flex-between">
          <!-- Official Logo -->
          <a href="/" class="brand-anchor" aria-label="Pearl Energy Homepage">
            <img
              src="/assets/pearlenergy/logo-energy-color.png"
              alt="Pearl Energy Australia"
              class="brand-logo-img"
              width="172"
              height="38"
            />
          </a>

          <!-- Navigation Links -->
          <nav class="desktop-navigation" aria-label="Main Navigation">
            {navLinks.map((item) => (
              <a href={item.href} class={`nav-item-link ${item.label === 'Home' ? 'current' : ''}`}>
                <span>{item.label}</span>
              </a>
            ))}
          </nav>

          <!-- Action Buttons -->
          <div class="header-actions-cluster">
            <a href="#locations" class="btn btn-radar">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>Find a Station</span>
            </a>

            <!-- Mobile Hamburger Trigger -->
            <button id="mobileMenuBtn" class="mobile-nav-trigger" aria-label="Toggle Mobile Navigation" aria-expanded="false">
              <span class="nav-bar"></span>
              <span class="nav-bar"></span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Mobile Drawer Panel -->
    <div id="mobileDrawer" class="nav-drawer" aria-hidden="true">
      <div class="drawer-backdrop" id="drawerBackdrop"></div>
      <div class="drawer-card">
        <div class="drawer-header flex-between">
          <img src="/assets/pearlenergy/logo-energy-color.png" alt="Pearl Energy" width="145" height="32" />
          <button id="drawerCloseBtn" class="drawer-close" aria-label="Close Navigation Menu">&times;</button>
        </div>
        <div class="drawer-links-wrapper">
          {navLinks.map((item) => (
            <a href={item.href} class="drawer-nav-item">
              <span>{item.label}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
        <div class="drawer-footer-actions">
          <a href="#locations" class="btn btn-primary btn-block">Find Nearest Station</a>
          <div class="drawer-contact-info">
            <span><strong>Head Office:</strong> Bella Vista NSW</span>
            <span>info@pearlenergy.com.au</span>
          </div>
        </div>
      </div>
    </div>

    <main id="main">
      <!-- =================================================================
           SECTION 02: CINEMATIC EDITORIAL HERO
           Authentic Australian Station Photography + Interactive Station Console
           ================================================================= -->
      <!-- 02: CINEMATIC EDITORIAL HERO & COMMAND CONSOLE -->
      <section class="hero-cinematic" id="hero">
