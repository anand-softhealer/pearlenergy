---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "Pearl Infotech is a leading IT solutions & software engineering agency in Australia specializing in Web Development, Mobile Apps (Android & iOS), Quality Assurance, and UI/UX.",
  activeNav = "",
  canonicalUrl,
} = Astro.props;

const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

  <!-- Google Fonts: Manrope (Weights 200..800 for Headings, Body, Nav, Buttons) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />

  <!-- Owl Carousel 2 CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />

  <!-- jQuery & Owl Carousel 2 JavaScript in Head -->
  <script is:inline src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content="/assets/images/logo-dark.png" />
</head>
<body>
  <!-- Top Info Bar (Apexa-inspired corporate header) -->
  <div class="header-topbar">
    <div class="container header-topbar-container">
      <div class="topbar-left">
        <span class="topbar-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Suite 202 Building B, 20 Lexington Dr, Bella Vista NSW 2153</span>
        </span>
      </div>
      <div class="topbar-right">
        <a href="mailto:info@pearlenergy.com.au" class="topbar-item topbar-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>info@pearlenergy.com.au</span>
        </a>
        <span class="topbar-divider"></span>
        <span class="topbar-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>Mon – Fri: 9:00 AM – 6:00 PM AEST</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Header / Navigation Bar -->
  <header class="site-header" id="site-header">
    <div class="container header-container">
      <a href="/it/" class="brand-link" aria-label="Pearl Infotech Homepage">
        <img src="/assets/images/logo-dark.png" alt="Pearl Infotech" class="brand-logo" width="220" height="45" />
      </a>

      <!-- Desktop Nav -->
      <nav class="desktop-nav" aria-label="Primary Navigation">
        <ul class="nav-list">
          <li>
            <a href="/it/" class:list={['nav-link', { active: activeNav === 'home' || currentPath === '/it/' || currentPath === '/' }]}>
              Home
            </a>
          </li>
          <li>
            <a href="/it/about-us/" class:list={['nav-link', { active: activeNav === 'about' || currentPath.includes('/it/about-us') }]}>
              About Company
            </a>
          </li>
          <li class="has-dropdown">
            <a href="/it/services/" class:list={['nav-link', { active: activeNav === 'services' || currentPath.includes('/it/services') || currentPath.includes('development') || currentPath.includes('assurance') || currentPath.includes('design') }]}>
              Services
              <svg class="dropdown-icon" width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="dropdown-menu">
              <a href="/it/web-development/" class="dropdown-item">
                <span class="dropdown-item-title">Web Development</span>
                <span class="dropdown-item-desc">Enterprise web, portals, WordPress & e-commerce</span>
              </a>
              <a href="/it/android-development/" class="dropdown-item">
                <span class="dropdown-item-title">Android Development</span>
                <span class="dropdown-item-desc">Native & hybrid mobile applications</span>
              </a>
              <a href="/it/ios-development/" class="dropdown-item">
                <span class="dropdown-item-title">iOS Development</span>
                <span class="dropdown-item-desc">iPhone & iPad custom applications</span>
              </a>
              <a href="/it/quality-assurance/" class="dropdown-item">
                <span class="dropdown-item-title">Quality Assurance</span>
                <span class="dropdown-item-desc">Automated & manual testing methods</span>
              </a>
              <a href="/it/ui-ux-design/" class="dropdown-item">
                <span class="dropdown-item-title">UI/UX Design</span>
                <span class="dropdown-item-desc">Human-centered digital product design</span>
              </a>
              <a href="/it/wearable-app-development/" class="dropdown-item">
                <span class="dropdown-item-title">Wearables App Development</span>
                <span class="dropdown-item-desc">Apple Watch, Wear OS & smart tech</span>
              </a>
            </div>
          </li>
          <li>
            <a href="/it/career/" class:list={['nav-link', { active: activeNav === 'career' || currentPath.includes('/it/career') }]}>
              Careers
            </a>
          </li>
          <li>
            <a href="/it/contact-us/" class:list={['nav-link', { active: activeNav === 'contact' || currentPath.includes('/it/contact-us') }]}>
              Contact Us
            </a>
          </li>
        </ul>
      </nav>

      <!-- Header Action -->
      <div class="header-action">
        <a href="/it/contact-us/#consultation-form" class="btn btn-primary btn-sm">
          Get Consultation
        </a>
        <button id="mobile-toggle" class="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
          <svg class="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg class="close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-nav" class="mobile-nav" aria-hidden="true">
      <ul class="mobile-nav-list">
        <li><a href="/it/" class="mobile-link">Home</a></li>
        <li><a href="/it/about-us/" class="mobile-link">About Company</a></li>
        <li>
          <div class="mobile-accordion-header">
            <a href="/it/services/" class="mobile-link">Services</a>
          </div>
          <ul class="mobile-sublinks">
            <li><a href="/it/web-development/">Web Development</a></li>
            <li><a href="/it/android-development/">Android Development</a></li>
            <li><a href="/it/ios-development/">iOS Development</a></li>
            <li><a href="/it/quality-assurance/">Quality Assurance</a></li>
            <li><a href="/it/ui-ux-design/">UI/UX Design</a></li>
            <li><a href="/it/wearable-app-development/">Wearables App Development</a></li>
          </ul>
        </li>
        <li><a href="/it/career/" class="mobile-link">Careers</a></li>
        <li><a href="/it/contact-us/" class="mobile-link">Contact Us</a></li>
      </ul>
      <div class="mobile-cta">
        <a href="/it/contact-us/#consultation-form" class="btn btn-primary btn-sm" style="width: 100%;">
          Get a Free Consultation
        </a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <!-- Global Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <!-- Col 1: Brand & Bio -->
        <div class="footer-col brand-col">
          <a href="/it/" class="footer-brand" aria-label="Pearl Infotech Homepage">
            <img src="/assets/images/logo-light.png" alt="Pearl Infotech" width="210" height="44" />
          </a>
          <p class="footer-text">
            Pearl Infotech is a growing team of creative, strategic, and professional engineers for software development in Australia.
          </p>
        </div>

        <!-- Col 2: Services -->
        <div class="footer-col">
          <h4 class="footer-heading">Services</h4>
          <ul class="footer-links">
            <li><a href="/it/web-development/">Web Development</a></li>
            <li><a href="/it/android-development/">Android Development</a></li>
            <li><a href="/it/ios-development/">iOS Development</a></li>
            <li><a href="/it/quality-assurance/">Quality Assurance</a></li>
            <li><a href="/it/ui-ux-design/">UI/UX Design</a></li>
            <li><a href="/it/wearable-app-development/">Wearables App Development</a></li>
          </ul>
        </div>

        <!-- Col 3: Quick Links -->
        <div class="footer-col">
          <h4 class="footer-heading">Company</h4>
          <ul class="footer-links">
            <li><a href="/it/">Home</a></li>
            <li><a href="/it/about-us/">About Company</a></li>
            <li><a href="/it/services/">All Services</a></li>
            <li><a href="/it/career/">Careers</a></li>
            <li><a href="/it/contact-us/">Contact Us</a></li>
            <li><a href="/it/contact-us/#consultation-form">Free Consultation</a></li>
          </ul>
        </div>

        <!-- Col 4: Contact Info -->
        <div class="footer-col contact-col">
          <h4 class="footer-heading">Contact Info</h4>
          <ul class="footer-contact-list">
            <li>
              <div class="contact-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="contact-detail">
                <span>Suite 202 Building B, 20 Lexington Dr, Bella Vista NSW 2153, Australia</span>
              </div>
            </li>
            <li>
              <div class="contact-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="contact-detail">
                <a href="mailto:info@pearlenergy.com.au">info@pearlenergy.com.au</a>
              </div>
            </li>
            <li>
              <div class="contact-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="contact-detail">
                <span>Mon – Fri: 9:00 AM – 6:00 PM (AEST)</span>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="copyright">&copy; Copyright {currentYear}. Pearl Infotech.</p>
      </div>
    </div>
  </footer>

  <!-- Floating Back to Top Button -->
  <button id="back-to-top" class="back-to-top" aria-label="Back to Top" title="Back to Top">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  <script>
    // Header Sticky Glassmorphism effect (scroll threshold 16px)
    const header = document.getElementById('site-header');
    const updateHeaderScroll = () => {
      if (window.scrollY > 16) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', updateHeaderScroll, { passive: true });
    updateHeaderScroll();

    // Mobile Navigation Drawer Toggle
    const toggle = document.getElementById('mobile-toggle');
    const mobileNav = document.getElementById('mobile-nav');

    toggle?.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      if (mobileNav) {
        mobileNav.setAttribute('aria-hidden', String(isExpanded));
        mobileNav.classList.toggle('open');
      }
      toggle.classList.toggle('active');
    });

    // Close mobile nav when clicking a link
    mobileNav?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.classList.remove('active');
      });
    });

    // Floating Back to Top Button
    const backToTopBtn = document.getElementById('back-to-top');
    const toggleBackToTop = () => {
      if (window.scrollY > 300) {
        backToTopBtn?.classList.add('visible');
      } else {
        backToTopBtn?.classList.remove('visible');
      }
    };
    window.addEventListener('scroll', toggleBackToTop, { passive: true });
    toggleBackToTop();

    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  </script>

  <style>
    /* Top Utility Bar (Apexa-inspired) */
    .header-topbar {
      background-color: var(--color-secondary); /* #111C3A */
      color: #94a3b8;
      font-size: 0.8125rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.375rem 0;
      line-height: 1.4;
      white-space: nowrap;
    }

    .header-topbar-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .topbar-left, .topbar-right {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .topbar-item {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: #cbd5e1;
    }

    .topbar-item svg {
      color: var(--color-primary);
      flex-shrink: 0;
    }

    .topbar-link:hover {
      color: #ffffff;
    }

    .topbar-divider {
      width: 1px;
      height: 14px;
      background: rgba(255, 255, 255, 0.15);
    }

    @media (max-width: 1023.98px) {
      .header-topbar {
        display: none;
      }
    }

    /* Header Styles */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
      transition: background-color 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
    }

    .site-header.scrolled {
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
      background: rgba(255, 255, 255, 0.98);
      border-color: rgba(226, 232, 240, 0.8);
    }

    .header-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 4.75rem;
      transition: height 200ms ease, padding 200ms ease;
    }

    .site-header.scrolled .header-container {
      height: 4rem;
    }

    .brand-link {
      display: flex;
      align-items: center;
    }

    .brand-logo {
      height: 40px;
      width: auto;
      object-fit: contain;
    }

    /* Desktop Nav */
    .desktop-nav {
      display: flex;
      align-items: center;
    }

    .nav-list {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-link {
      font-family: var(--font-heading);
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--color-heading);
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.5rem 0;
      position: relative;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0%;
      height: 2px;
      background-color: var(--color-primary);
      transition: width 200ms ease;
      border-radius: var(--radius-sm);
    }

    .nav-link:hover, .nav-link.active {
      color: var(--color-primary);
    }

    .nav-link:hover::after, .nav-link.active::after {
      width: 100%;
    }

    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .site-header,
      .site-header.scrolled,
      .header-container,
      .site-header.scrolled .header-container,
      .nav-link,
      .nav-link::after,
      .nav-link:hover::after,
      .nav-link.active::after,
      .dropdown-menu,
      .dropdown-icon {
        transition: none !important;
      }
    }

    /* Dropdown */
    .has-dropdown {
      position: relative;
    }

    .dropdown-icon {
      transition: transform var(--transition-fast);
    }

    .has-dropdown:hover .dropdown-icon {
      transform: rotate(180deg);
    }

    .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%) translateY(10px);
      width: 320px;
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--card-radius);
      padding: 0.75rem;
      box-shadow: var(--shadow-soft-xl);
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition-fast);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .has-dropdown:hover .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }

    .dropdown-item {
      display: flex;
      flex-direction: column;
      padding: 0.625rem 0.875rem;
      border-radius: var(--radius-sm);
      transition: background var(--transition-fast);
    }

    .dropdown-item:hover {
      background-color: var(--color-primary-subtle);
    }

    .dropdown-item-title {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-heading);
    }

    .dropdown-item:hover .dropdown-item-title {
      color: var(--color-primary);
    }

    .dropdown-item-desc {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      margin-top: 0.125rem;
    }

    /* Header Actions */
    .header-action {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .mobile-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--color-heading);
      padding: 0.5rem;
      position: relative;
    }

    .mobile-toggle .close-icon {
      display: none;
    }

    .mobile-toggle.active .hamburger-icon {
      display: none;
    }

    .mobile-toggle.active .close-icon {
      display: block;
    }

    /* Mobile Nav Drawer */
    .mobile-nav {
      display: none;
      border-top: 1px solid var(--color-border);
      background: #ffffff;
      padding: 1.5rem;
    }

    .mobile-nav-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .mobile-link {
      font-size: 1.0625rem;
      font-weight: 600;
      color: var(--color-heading);
    }

    .mobile-sublinks {
      padding-left: 1rem;
      margin-top: 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      border-left: 2px solid var(--color-border-subtle);
    }

    .mobile-sublinks a {
      font-size: 0.9375rem;
      color: var(--color-text-muted);
    }

    .mobile-sublinks a:hover {
      color: var(--color-primary);
    }

    .mobile-cta {
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
    }

    @media (max-width: 991px) {
      .desktop-nav {
        display: none;
      }
      .mobile-toggle {
        display: block;
      }
      .mobile-nav.open {
        display: block;
      }
    }

    @media (max-width: 640px) {
      .header-container {
        height: 4.25rem;
      }
      .brand-logo {
        height: 32px;
      }
      .header-action {
        gap: 0.625rem;
      }
      .header-action .btn {
        padding: 0.5rem 0.875rem;
        font-size: 0.8125rem;
        line-height: 1.2;
      }
    }

    @media (max-width: 380px) {
      .brand-logo {
        height: 28px;
      }
      .header-action .btn {
        padding: 0.45rem 0.65rem;
        font-size: 0.75rem;
      }
    }

    /* Footer Styles */
    .site-footer {
      background-color: var(--color-secondary);
      color: #94A3B8;
      padding-top: clamp(2.5rem, 5vw, 4rem);
      padding-bottom: 2.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1.8fr;
      gap: 3rem;
      margin-bottom: 2.5rem;
    }

    @media (max-width: 1023.98px) {
      .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
      }
    }

    @media (max-width: 640px) {
      .footer-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }

    .footer-brand img {
      margin-bottom: 1.25rem;
    }

    .footer-text {
      font-size: 0.9375rem;
      line-height: 1.7;
      color: #fff;
      margin-bottom: 1.5rem;
      max-width: 380px;
    }

    .footer-tag {
      font-size: 0.75rem;
      font-weight: 500;
      color: #FFFFFF;
      background: rgba(255, 255, 255, 0.08);
      padding: 0.25rem 0.625rem;
      border-radius: var(--radius-sm);
    }

    .footer-heading {
