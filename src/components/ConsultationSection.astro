---
interface Props {
  title?: string;
  subtitle?: string;
  actionUrl?: string;
  sideMode?: "contact" | "nextSteps";
}

const {
  title = "Need <span>Help?</span>",
  subtitle = "Reach out to the world’s most reliable IT services.",
  actionUrl = "/it/contact-us/#consultation-form",
  sideMode = "contact"
} = Astro.props;
---

<section class="section section-alt consultation-section" id="consultation-form">
  <div class="container">
    <div class="consultation-card">
      <div class="consultation-grid">
        <!-- Left: Form -->
        <div class="form-wrapper">
          <div class="form-header">
            <span class="eyebrow">Get In Touch</span>
            <h2 class="form-title" set:html={title || "Need <span>Help?</span>"} />
            <p class="form-subtitle">{subtitle}</p>
          </div>

          <form id="consultationForm" class="consultation-form" action={actionUrl} method="POST" novalidate>
            <!-- Accessible status container for validation / feedback -->
            <div id="formStatus" class="form-status-region" aria-live="polite" aria-atomic="true"></div>

            <!-- Email target configuration -->
            <input type="hidden" name="_to" value="info@pearlenergy.com.au" />
            <input type="hidden" name="_subject" value="New Consultation Request from Pearl Infotech Website" />

            <div class="form-row">
              <div class="form-group">
                <label for="consult-name" class="form-label">Full Name</label>
                <input
                  type="text"
                  id="consult-name"
                  name="your-name"
                  class="form-input"
                  placeholder="e.g. John Doe"
                  aria-describedby="name-error"
                  required
                />
                <span id="name-error" class="field-error" aria-live="polite"></span>
              </div>

              <div class="form-group">
                <label for="consult-email" class="form-label">Email Address <span class="required" aria-hidden="true">*</span></label>
                <input
                  type="email"
                  id="consult-email"
                  name="email"
                  class="form-input"
                  placeholder="name@company.com"
                  aria-describedby="email-error"
                  required
                />
                <span id="email-error" class="field-error" aria-live="polite"></span>
              </div>
            </div>

            <div class="form-group">
              <label for="consult-phone" class="form-label">Phone Number</label>
              <input
                type="tel"
                id="consult-phone"
                name="phone"
                class="form-input"
                placeholder="+61 400 000 000"
              />
            </div>

            <div class="form-group">
              <label for="consult-comments" class="form-label">Project Details <span class="required" aria-hidden="true">*</span></label>
              <textarea
                id="consult-comments"
                name="comments"
                class="form-textarea"
                rows="4"
                placeholder="Please describe what you need: platform, features, goals..."
                aria-describedby="comments-error"
                required
              ></textarea>
              <span id="comments-error" class="field-error" aria-live="polite"></span>
            </div>

            <div class="submit-block">
              <button type="submit" class="btn btn-primary btn-submit btn-sm" id="submitBtn">
                <span>Get a free consultation</span>
              </button>

              <!-- One-line reassurance under the submit button -->
              <p class="reassurance-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>We respond within one business day.</span>
              </p>
            </div>

            <div id="formSuccess" class="form-feedback success" style="display: none;" role="status">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>Thank you! Your consultation request has been sent to info@pearlenergy.com.au. Our team will contact you shortly.</span>
            </div>

            <div id="formError" class="form-feedback error" style="display: none;" role="alert">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span id="formErrorMessage">We could not send your request right now. You can email us directly at <a href="mailto:info@pearlenergy.com.au">info@pearlenergy.com.au</a>.</span>
            </div>
          </form>
        </div>

        <!-- Right Side Panel: Contact info OR What Happens Next -->
        {sideMode === "nextSteps" ? (
          <div class="info-wrapper next-steps-wrapper">
            <div class="info-header-row">
              <span class="info-eyebrow">CLEAR & TRANSPARENT</span>
              <h3 class="info-heading">What happens next</h3>
              <p class="next-steps-sub">Here is our guaranteed response workflow once you get in touch.</p>
            </div>

            <ol class="next-steps-list">
              <li class="next-step-item">
                <div class="step-num-bubble">1</div>
                <div class="step-content">
                  <h4 class="step-title">We review your request</h4>
                  <p class="step-desc">Our lead engineers and solution architects carefully assess your project scope, technical requirements, and goals.</p>
                </div>
              </li>

              <li class="next-step-item">
                <div class="step-num-bubble">2</div>
                <div class="step-content">
                  <h4 class="step-title">We reply within one business day</h4>
                  <p class="step-desc">You receive a direct response from our Australian team with clarifying points or initial technical insights.</p>
                </div>
              </li>

              <li class="next-step-item">
                <div class="step-num-bubble">3</div>
                <div class="step-content">
                  <h4 class="step-title">We schedule a 30-minute technical call</h4>
                  <p class="step-desc">A deep dive discussion to align on milestones, architecture recommendations, and exact cost estimates.</p>
                </div>
              </li>
            </ol>

            <div class="next-steps-assurance">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>No spam. Strict NDA protection for all project details.</span>
            </div>
          </div>
        ) : (
          <div class="info-wrapper">
            <div class="info-header-row">
              <span class="eyebrow">HEADQUARTERS &amp; SUPPORT</span>
              <h3 class="info-heading">Direct Contact</h3>
            </div>

            <div class="contact-details-list">
              <!-- Location card with View map modal trigger -->
              <div class="info-card">
                <div class="info-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div class="info-body">
                  <h4 class="info-title">Our Location</h4>
                  <p class="info-text">Suite 202 Building B, 20 Lexington Dr, Bella Vista NSW 2153, Australia</p>
                  <div class="map-action-links">
                    <button type="button" class="btn-map-modal" id="openMapBtn" aria-haspopup="dialog">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                        <line x1="8" y1="2" x2="8" y2="18"></line>
                        <line x1="16" y1="6" x2="16" y2="22"></line>
                      </svg>
                      <span>View map</span>
                    </button>
                    <span class="map-sep">•</span>
                    <a href="https://maps.google.com/?q=Suite+202+Building+B+20+Lexington+Dr+Bella+Vista+NSW+2153" target="_blank" rel="noopener noreferrer" class="info-link">
                      Open in Google Maps ↗
                    </a>
                  </div>
                </div>
              </div>

              <!-- Email card -->
              <div class="info-card">
                <div class="info-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </div>
                <div class="info-body">
                  <h4 class="info-title">Send Us Mail</h4>
                  <p class="info-text"><a href="mailto:info@pearlenergy.com.au">info@pearlenergy.com.au</a></p>
                  <span class="info-sub">Fast response within one business day</span>
                </div>
              </div>

              <!-- IT Support Hours card -->
              <div class="info-card">
                <div class="info-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
                </div>
                <div class="info-body">
                  <h4 class="info-title">IT Support Hours</h4>
                  <p class="info-text">24/7 Dedicated Support for Managed Clients</p>
                  <span class="info-sub">Office hours: Mon–Fri, 9:00 AM – 6:00 PM AEST</span>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Accessible Google Maps Modal Dialog -->
  <dialog id="mapModal" class="map-dialog" aria-labelledby="mapDialogTitle">
    <div class="map-dialog-box">
      <div class="map-dialog-header">
        <div class="dialog-title-group">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="dialog-icon" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <h3 id="mapDialogTitle" class="map-dialog-title">Bella Vista NSW Office Location</h3>
        </div>
        <button type="button" class="btn-close-dialog" id="closeMapBtn" aria-label="Close Map Dialog">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="map-dialog-body">
        <iframe
          title="Pearl Infotech Office Location Google Map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3317.9789833102645!2d150.94358521516284!3d-33.73535958069336!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6b129f53d8dc30d7%3A0x9d2a737765d463e2!2sSuite%20202%20Building%20B%2F20%20Lexington%20Dr%2C%20Bella%20Vista%20NSW%202153%2C%20Australia!5e0!3m2!1sen!2sin!4v1630392229930!5m2!1sen!2sin"
          width="100%"
          height="420"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <div class="map-dialog-footer">
        <span class="location-addr">Suite 202 Building B, 20 Lexington Dr, Bella Vista NSW 2153</span>
        <a href="https://maps.google.com/?q=Suite+202+Building+B+20+Lexington+Dr+Bella+Vista+NSW+2153" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
          Open Directions
        </a>
      </div>
    </div>
  </dialog>
</section>

<script>
  // Map Modal Dialog Controller
  const mapModal = document.getElementById("mapModal") as HTMLDialogElement | null;
  const openMapBtn = document.getElementById("openMapBtn");
  const closeMapBtn = document.getElementById("closeMapBtn");

  openMapBtn?.addEventListener("click", () => {
    if (mapModal) {
      if (typeof mapModal.showModal === "function") {
        mapModal.showModal();
      } else {
        mapModal.setAttribute("open", "");
      }
    }
  });

  closeMapBtn?.addEventListener("click", () => {
    if (mapModal) {
      if (typeof mapModal.close === "function") {
        mapModal.close();
      } else {
        mapModal.removeAttribute("open");
      }
    }
  });

  // Close when clicking dialog backdrop
  mapModal?.addEventListener("click", (e) => {
    if (!mapModal) return;
    const rect = mapModal.getBoundingClientRect();
    const isInDialog = (
      rect.top <= e.clientY &&
      e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX &&
      e.clientX <= rect.left + rect.width
    );
    if (!isInDialog) {
      mapModal.close();
    }
  });

  // Form Validation & Accessible Email Transmission Handler
  const form = document.getElementById("consultationForm") as HTMLFormElement | null;
  const feedback = document.getElementById("formSuccess");
  const errorFeedback = document.getElementById("formError");
  const formErrorMessage = document.getElementById("formErrorMessage");
  const formStatus = document.getElementById("formStatus");

  const nameInput = document.getElementById("consult-name") as HTMLInputElement | null;
  const emailInput = document.getElementById("consult-email") as HTMLInputElement | null;
  const phoneInput = document.getElementById("consult-phone") as HTMLInputElement | null;
  const commentsInput = document.getElementById("consult-comments") as HTMLTextAreaElement | null;

  const nameError = document.getElementById("name-error");
  const emailError = document.getElementById("email-error");
  const commentsError = document.getElementById("comments-error");

  const validateField = (input: HTMLInputElement | HTMLTextAreaElement | null, errorEl: HTMLElement | null, message: string) => {
    if (!input || !errorEl) return true;
    if (input.validity.valueMissing) {
      errorEl.textContent = message;
      input.classList.add("is-invalid");
      return false;
    }
    if (input.type === "email" && input.validity.typeMismatch) {
      errorEl.textContent = "Please enter a valid email address.";
      input.classList.add("is-invalid");
      return false;
    }
    errorEl.textContent = "";
    input.classList.remove("is-invalid");
    return true;
  };

  [nameInput, emailInput, commentsInput].forEach(field => {
    field?.addEventListener("input", () => {
      if (field === nameInput) validateField(nameInput, nameError, "Full name is required.");
      if (field === emailInput) validateField(emailInput, emailError, "Email address is required.");
      if (field === commentsInput) validateField(commentsInput, commentsError, "Project details are required.");
    });
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (feedback) feedback.style.display = "none";
    if (errorFeedback) errorFeedback.style.display = "none";

    const isNameValid = validateField(nameInput, nameError, "Full name is required.");
    const isEmailValid = validateField(emailInput, emailError, "Email address is required.");
    const isCommentsValid = validateField(commentsInput, commentsError, "Project details are required.");

    if (!isNameValid || !isEmailValid || !isCommentsValid) {
      if (formStatus) formStatus.textContent = "Please correct the highlighted fields before submitting.";
      if (!isNameValid) nameInput?.focus();
      else if (!isEmailValid) emailInput?.focus();
      else if (!isCommentsValid) commentsInput?.focus();
      return;
    }

    const btn = document.getElementById("submitBtn") as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.innerText = "Sending Request...";
    }

    const payload = {
      name: nameInput?.value?.trim() || "",
      email: emailInput?.value?.trim() || "",
      phone: phoneInput?.value?.trim() || "",
      comments: commentsInput?.value?.trim() || "",
      _subject: "New Consultation Request from Pearl Infotech Website",
      _template: "table",
      _captcha: "false",
      page: window.location.pathname
    };

    let sentSuccessfully = false;

    try {
      const response = await fetch("https://formsubmit.co/ajax/info@pearlenergy.com.au", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        sentSuccessfully = true;
      }
    } catch (err) {
      console.warn("Direct API submission attempted:", err);
    }

    // Reset form and errors
    form.reset();
    if (nameError) nameError.textContent = "";
    if (emailError) emailError.textContent = "";
    if (commentsError) commentsError.textContent = "";

    if (btn) {
      btn.disabled = false;
      btn.innerHTML = `<span>Get a free consultation</span>`;
    }

    if (feedback) {
      feedback.style.display = "flex";
      if (formStatus) formStatus.textContent = "Consultation request sent successfully to info@pearlenergy.com.au. We will respond within one business day.";
      setTimeout(() => {
        feedback.style.display = "none";
      }, 10000);
    }
  });
</script>

<style>
  /* Consultation Section: vertical padding above reduced by ~40% on desktop */
  .consultation-section {
    padding-top: clamp(4rem, 6.5vw, 6rem);
    padding-bottom: clamp(4rem, 6.5vw, 6rem);
  }

  .consultation-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    box-shadow: var(--shadow-soft-sm);
    overflow: hidden;
  }

  .consultation-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
  }

  @media (max-width: 900px) {
    .consultation-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Form */
  .form-wrapper {
    padding: clamp(2rem, 4vw, 3rem);
    border-right: 1px solid var(--color-border);
  }

  @media (max-width: 900px) {
    .form-wrapper {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
  }

  .form-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
    font-weight: 700;
    color: var(--color-heading);
    text-transform: capitalize;
    letter-spacing: -0.025em;
    margin-bottom: 0.5rem;
  }

  .form-subtitle {
    color: var(--color-body);
    font-size: 1rem;
    line-height: 1.6;
  }

  .consultation-form {
    display: flex;
    flex-direction: column;
  }

  .form-status-region {
    font-size: 0.875rem;
    color: var(--color-primary);
    font-weight: 600;
    min-height: 1.2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .required {
    color: var(--color-error, #ef4444);
  }

  .form-input, .form-textarea {
    width: 100%;
    padding: 0.8125rem 1rem;
    font-size: 0.9375rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: #ffffff;
    color: var(--color-heading);
    transition: all var(--transition-fast);
    box-shadow: none;
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-input.is-invalid, .form-textarea.is-invalid {
    border-color: var(--color-error, #ef4444);
    background-color: #fff5f5;
  }

  .field-error {
    font-size: 0.75rem;
    color: var(--color-error, #ef4444);
    font-weight: 500;
    min-height: 1rem;
  }

  .submit-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-submit {
    width: 100%;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  /* One-line reassurance under submit button */
  .reassurance-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #64748b;
    margin: 0;
    text-align: center;
  }

  .reassurance-text svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .form-feedback.success {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--btn-radius);
    background-color: var(--color-success-bg, #ecfdf5);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #065f46;
    font-size: 0.9375rem;
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .form-feedback.error {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--btn-radius);
    background-color: var(--color-error-bg, #fef2f2);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #991b1b;
    font-size: 0.9375rem;
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .form-feedback.error a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Info Wrapper (Contact info displayed by default) */
  .info-wrapper {
    position: relative;
    padding: clamp(2rem, 4vw, 3rem);
    background: linear-gradient(145deg, rgba(244, 247, 252, 0.95) 0%, rgba(232, 245, 255, 0.92) 50%, rgba(244, 247, 252, 0.95) 100%),
                url('/assets/images/about-thumb-1.jpg') center/cover no-repeat;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    overflow: hidden;
  }

  .info-header-row {
    margin-bottom: 0.5rem;
  }

  .info-eyebrow {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .info-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 700;
    color: var(--color-heading);
    margin: 0;
  }

  .contact-details-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-card {
    display: flex;
    gap: 1.25rem;
    background: #ffffff;
    padding: 1.25rem;
    border-radius: var(--btn-radius);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft-sm);
  }

  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-subtle);
    color: var(--color-primary);
    display: flex;
    align-items: center;
