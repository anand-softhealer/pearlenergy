---
import Layout from '../layouts/Layout.astro';
import ConsultationSection from './ConsultationSection.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import ClientAvatar from './ClientAvatar.astro';

interface Props {
  serviceKey: string;
  title: string;
  headline: string;
  tagline: string;
  description: string[];
  capabilitiesTitle: string;
  capabilities: string[];
  heroImage: string;
  heroVisualType?: 'product' | 'image';
}

const {
  serviceKey,
  title,
  headline,
  tagline,
  description,
  capabilitiesTitle,
  capabilities,
  heroImage
} = Astro.props;
---

<Layout title={`${title} — Pearl Infotech`} description={description[0]} activeNav="services">
  <!-- Service Hero / Sub-Banner -->
  <section class="service-hero page-sub-banner">
    <div class="sub-banner-glow"></div>
    <div class="sub-banner-pattern" aria-hidden="true"></div>
    <div class="container sub-banner-container">
      <div class="service-hero-grid">
        <div class="service-hero-content">
          <div class="breadcrumb-pill">
            <a href="/it/" class="breadcrumb-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              <span>Home</span>
            </a>
            <span class="sep" aria-hidden="true">/</span>
            <a href="/it/services/" class="breadcrumb-link">Services</a>
            <span class="sep" aria-hidden="true">/</span>
            <span class="current">{title}</span>
          </div>
          <div class="header-content">
            <span class="sub-banner-eyebrow">{headline}</span>
            <h1 class="service-title">{title}</h1>
            <p class="service-tagline">{tagline}</p>
          </div>
          <div class="hero-actions">
            <a href="#consultation-form" class="btn btn-primary btn-sm">
              Request Service Quote
            </a>
            <a href="#capabilities" class="btn btn-outline-light btn-sm">
              View Capabilities
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Details Section -->
  <section class="section service-body-section" id="capabilities">
    <div class="container">
      <div class="service-grid">
        <!-- Main Content Column -->
        <div class="service-main">
          <!-- Overview Prose Block -->
          <div class="prose-block">
            <h2 class="content-title">Overview &amp; <span>Approach</span></h2>
            {description.map((paragraph) => (
              <p class="service-para">{paragraph}</p>
            ))}
          </div>



          <!-- Capabilities Grid (Two columns on desktop, single column on mobile) -->
          <div class="capabilities-box">
            <div class="cap-header">
              <span class="eyebrow">Our Technical Capabilities</span>
              <h3 class="cap-title">{capabilitiesTitle}</h3>
            </div>

            <div class="cap-list">
              {capabilities.map((item) => (
                <div class="cap-item">
                  <div class="cap-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <span class="cap-text">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sticky Sidebar (position: sticky; top: 96px) -->
        <aside class="service-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-title">Explore Services</h3>
            <ul class="sidebar-nav">
              <li>
                <a href="/it/web-development/" class:list={[{ active: serviceKey === 'web' }]}>
                  Web Development
                </a>
              </li>
              <li>
                <a href="/it/android-development/" class:list={[{ active: serviceKey === 'android' }]}>
                  Android Development
                </a>
              </li>
              <li>
                <a href="/it/ios-development/" class:list={[{ active: serviceKey === 'ios' }]}>
                  iOS Development
                </a>
              </li>
              <li>
                <a href="/it/quality-assurance/" class:list={[{ active: serviceKey === 'qa' }]}>
                  Quality Assurance
                </a>
              </li>
              <li>
                <a href="/it/ui-ux-design/" class:list={[{ active: serviceKey === 'uiux' }]}>
                  UI/UX Design
                </a>
              </li>
              <li>
                <a href="/it/wearable-app-development/" class:list={[{ active: serviceKey === 'wearables' }]}>
                  Wearables App Development
                </a>
              </li>
            </ul>
          </div>

          <!-- Ready to Start CTA Card -->
          <div class="sidebar-cta">
            <span class="badge">Direct Help</span>
            <h4 class="cta-heading">Ready to Start Your Project?</h4>
            <p class="cta-desc">Speak directly with our Australian development engineers today.</p>
            <a href="#consultation-form" class="btn btn-primary btn-sm" style="width: 100%;">
              Get Free Consultation
            </a>
          </div>

          <!-- Verified Client Testimonial (Fills empty space below CTA) -->
          <div class="sidebar-testimonial-card">
            <div class="stars-row" aria-label="5 stars rating">★★★★★</div>
            <p class="side-quote">
              “Pearl Infotech team is a life saver. Friendly, dedicated and genuine problem solvers. 100% Recommended!”
            </p>
            <div class="side-author">
              <ClientAvatar name="Ocean Babs" size={40} />
              <div class="side-author-info">
                <strong>Ocean Babs</strong>
                <span>Head of IT · TechCorp</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Consultation Form -->
  <ConsultationSection
    title={`Consult on <span>${title}</span>`}
    subtitle="Let's build robust, scalable and secure software tailored to your specific business."
  />
</Layout>

<style>
  /* Sub-Banner / Service Hero */
  .page-sub-banner {
    position: relative;
    background: linear-gradient(135deg, rgba(0, 29, 76, 0.78) 0%, rgba(0, 75, 140, 0.68) 50%, rgba(0, 135, 202, 0.62) 100%),
                url('/assets/images/sub-banner-service.jpg') center/cover no-repeat;
    color: #ffffff;
    padding: clamp(3.5rem, 5.5vw, 4.75rem) 0 clamp(3.5rem, 6vw, 5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    isolation: isolate;
  }

  .sub-banner-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 600px 320px at 85% 20%, rgba(0, 135, 202, 0.35), transparent 70%),
      radial-gradient(ellipse 450px 280px at 15% 85%, rgba(0, 135, 202, 0.2), transparent 70%);
    z-index: 0;
  }

  .sub-banner-pattern {
    position: absolute;
    right: -6vw;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(280px, 35vw, 460px);
    height: clamp(280px, 35vw, 460px);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 2.5rem rgba(255, 255, 255, 0.02),
      0 0 0 5rem rgba(255, 255, 255, 0.015),
      0 0 0 7.5rem rgba(255, 255, 255, 0.01);
    pointer-events: none;
    z-index: 0;
  }

  .sub-banner-container {
    position: relative;
    z-index: 1;
  }

  .service-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (max-width: 991px) {
    .service-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* Breadcrumb Pill */
  .breadcrumb-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.8125rem;
    color: #CBD5E1;
    margin-bottom: 1.5rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary-subtle);
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: #fff;
  }

  .breadcrumb-pill .sep {
    color: rgba(255, 255, 255, 0.35);
  }

  .breadcrumb-pill .current {
    color: #ffffff;
    font-weight: 600;
  }

  .service-hero-content {
    max-width: 680px;
  }

  .sub-banner-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .sub-banner-eyebrow::before {
    content: '';
    display: inline-block;
    width: 1.25rem;
    height: 2px;
    background-color: #fff;
    border-radius: var(--radius-sm);
  }

  .service-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.125rem;
    color: #ffffff;
  }

  .service-tagline {
    font-size: clamp(1.0625rem, 1.2vw, 1.1875rem);
    line-height: 1.7;
    color: #e2e8f0;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Hero Supporting Visual */
  .service-hero-visual-col {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-visual-card {
    width: 100%;
    position: relative;
    border-radius: 20px;
    padding: 8px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 100%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 24px 60px -12px rgba(10, 16, 32, 0.75);
    overflow: hidden;
  }

  .hero-card-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(0, 135, 202, 0.3) 0%, transparent 65%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .mockup-frame {
    position: relative;
    background: #001d4c;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(0, 135, 202, 0.35);
    z-index: 1;
  }

  .mockup-bar {
    background: #001433;
    padding: 0.5rem 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mockup-dots {
    display: flex;
    gap: 5px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-red { background: #ef4444; }
  .dot-amber { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .mockup-url-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 0.15rem 0.6rem;
    font-size: 0.6875rem;
    color: #94a3b8;
    font-family: monospace;
    flex-grow: 1;
  }

  .mockup-url-bar svg {
    color: var(--color-primary);
  }

  .mockup-content {
    background: #0b152d;
  }

  :global(.mockup-img) {
    width: 100%;
    height: auto;
    max-height: 340px;
    object-fit: cover;
    display: block;
  }

  /* Grid Layout: Main vs Sidebar */
  .service-body-section {
    padding-top: clamp(4rem, 6.5vw, 6rem);
    padding-bottom: clamp(4rem, 6.5vw, 6rem);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: clamp(2.5rem, 4vw, 4rem);
    align-items: start;
  }

  @media (max-width: 1023.98px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }

  .service-main {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .content-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-heading);
    letter-spacing: -0.03em;
    text-transform: capitalize;
    margin-bottom: 1.25rem;
  }

  .service-para {
    font-size: clamp(1rem, 1.1vw, 1.0625rem);
    line-height: 1.8;
    color: var(--color-body);
    margin-bottom: 1.25rem;
  }

  .service-para:last-child {
    margin-bottom: 0;
  }



  /* Capabilities Box: Two-column grid on desktop, single column on mobile */
  .capabilities-box {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    padding: clamp(1.75rem, 3vw, 2.75rem);
  }

  .cap-header {
    margin-bottom: 2rem;
  }

  .cap-title {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 1.8vw, 1.75rem);
    font-weight: 700;
    color: var(--color-heading);
    letter-spacing: -0.02em;
  }

  .cap-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .cap-list {
      grid-template-columns: 1fr;
    }
  }

  .cap-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background: #ffffff;
    padding: 0.9375rem 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft-sm);
  }

  .cap-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-subtle);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cap-text {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  /* Sticky Sidebar on Desktop (position: sticky; top: 96px) */
  .service-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-self: start;
    position: sticky;
    top: 96px;
    z-index: 10;
  }

  .sidebar-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    padding: var(--card-padding);
    box-shadow: var(--shadow-soft-sm);
  }

  .sidebar-title {
    font-family: var(--font-heading);
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-nav a {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-heading);
    transition: all var(--transition-fast);
    border-left: 3px solid transparent;
  }

  .sidebar-nav a:hover {
    background: var(--color-primary-subtle);
    color: var(--color-primary);
    border-left-color: var(--color-primary);
    transform: translateX(3px);
  }

  .sidebar-nav a.active {
    background: var(--color-primary-subtle);
    color: var(--color-primary);
    border-left-color: var(--color-primary);
    font-weight: 700;
  }

  /* CTA Box */
  .sidebar-cta {
    background: linear-gradient(135deg, var(--color-secondary) 0%, #002b66 100%);
    color: #ffffff;
    border-radius: var(--card-radius);
    padding: var(--card-padding);
    box-shadow: var(--shadow-soft-md);
    position: relative;
    overflow: hidden;
  }

  .sidebar-cta .badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }

  .cta-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #ffffff;
  }

  .cta-desc {
    font-size: 0.875rem;
    color: #CBD5E1;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  /* Sidebar Testimonial Card */
  .sidebar-testimonial-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-soft-sm);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .stars-row {
    color: #f59e0b;
    font-size: 1rem;
    letter-spacing: 0.1em;
  }

  .side-quote {
    font-size: 0.875rem;
    font-style: italic;
    color: var(--color-heading);
    line-height: 1.6;
  }

  .side-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .side-author-info {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .side-author-info strong {
    font-size: 0.875rem;
    color: var(--color-heading);
  }

  .side-author-info span {
    font-size: 0.75rem;
    color: var(--color-body);
  }
</style>
