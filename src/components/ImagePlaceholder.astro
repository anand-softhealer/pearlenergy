---
interface Props {
  src?: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  label?: string;
}

const {
  src,
  alt,
  width = 600,
  height = 400,
  class: className = '',
  loading = 'lazy',
  label = 'Real Team / Project Photo Placeholder',
} = Astro.props;
---

{src ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
  />
) : (
  <div class:list={['image-placeholder-box', className]} style={`aspect-ratio: ${width} / ${height};`}>
    <div class="placeholder-pattern" aria-hidden="true"></div>
    <div class="placeholder-content">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      <span class="placeholder-label">{label}</span>
      <span class="placeholder-dim">{width} × {height}</span>
    </div>
  </div>
)}

<style>
  .image-placeholder-box {
    width: 100%;
    background: linear-gradient(135deg, #0b152d 0%, #001d4c 100%);
    border: 2px dashed rgba(0, 135, 202, 0.4);
    border-radius: var(--card-radius, 16px);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .placeholder-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: radial-gradient(rgba(255, 255, 255, 0.3) 1px, transparent 1px);
    background-size: 16px 16px;
    pointer-events: none;
  }

  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    color: #94a3b8;
    z-index: 1;
  }

  .placeholder-content svg {
    color: var(--color-primary, #0087ca);
  }

  .placeholder-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #e2e8f0;
  }

  .placeholder-dim {
    font-size: 0.75rem;
    color: #64748b;
    font-family: monospace;
  }
</style>
